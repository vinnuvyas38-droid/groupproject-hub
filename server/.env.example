# Copy this file to .env and fill in your values
# NEVER commit .env to git

# Port the server listens on
PORT=5000

# Set to "production" when deploying
NODE_ENV=development

# Your MongoDB connection string
# For local development: mongodb://127.0.0.1:27017/groupproject-hub
# For MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/groupproject-hub
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/groupproject-hub

# The URL of your frontend (used for CORS)
# For local dev: http://localhost:5173
CLIENT_URL=http://localhost:5173

